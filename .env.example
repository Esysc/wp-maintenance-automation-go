# WP Maintenance Automation Go - Environment Configuration
#
# Per-site configuration (SSH hosts, DB credentials, restic, etc.)
# is managed through the Web UI and stored in the database.

# Domain for reverse proxy
# When set (e.g. example.com), Caddy auto-provisions Let's Encrypt certs.
# When empty, Caddy uses self-signed TLS (tls internal) for localhost.
WP_MAINTENANCE_DOMAIN=

# Extra Caddy site address, e.g. your LAN IP, to also serve HTTPS on.
# Needed when you access the UI via an IP instead of a hostname.
# Example: WP_MAINTENANCE_HOSTS=192.168.1.116
# Browsers don't send SNI for IP addresses, so this also drives
# WP_MAINTENANCE_DEFAULT_SNI (below) so Caddy serves the right certificate.
WP_MAINTENANCE_HOSTS=

# TLS server name used for SNI-less / IP connections (served cert selector).
# Defaults to WP_MAINTENANCE_HOSTS, falling back to "localhost".
# You normally don't need to set this manually.
WP_MAINTENANCE_DEFAULT_SNI=

# Restic backup repository password
# This is automatically written to a file at container startup.
# Leave empty if you don't use restic or set passwords per-site.
RESTIC_PASSWORD=
