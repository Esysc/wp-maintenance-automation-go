ARG WP_VERSION=6.6.2
ARG WP_PHP_VERSION=8.3

# Use the official PHP Apache image so any supported PHP major/minor can be
# matched to the production host. Debian's own repositories only ship a single
# PHP version, which made it impossible to rehearse sites on PHP 8.3+.
FROM php:${WP_PHP_VERSION}-apache

ARG WP_VERSION
ARG WP_PHP_VERSION

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libfreetype6-dev \
    libjpeg62-turbo-dev \
    libpng-dev \
    libzip-dev \
    mariadb-client \
    openssh-server \
    openssl \
    rsync \
    sudo \
 && docker-php-ext-configure gd --with-freetype --with-jpeg \
 && docker-php-ext-install -j"$(nproc)" gd mysqli zip \
 && rm -rf /var/lib/apt/lists/*

RUN a2enmod rewrite ssl
RUN mkdir -p /etc/apache2/ssl \
 && openssl req -x509 -nodes -days 3650 -newkey rsa:2048 \
    -keyout /etc/apache2/ssl/localhost.key \
    -out /etc/apache2/ssl/localhost.crt \
    -subj "/CN=localhost/O=Staging/C=CH" \
    -addext "subjectAltName=DNS:localhost,IP:127.0.0.1"

COPY apache-default-ssl.conf /etc/apache2/sites-available/default-ssl.conf
RUN a2ensite default-ssl

RUN curl -fS -o /usr/local/bin/wp-cli https://raw.githubusercontent.com/wp-cli/builds/gh-pages/phar/wp-cli.phar \
 && chmod +x /usr/local/bin/wp-cli \
 && printf '#!/bin/bash\n/usr/local/bin/wp-cli --allow-root --path=/var/www/html "$@"\n' > /usr/local/bin/wp \
 && chmod +x /usr/local/bin/wp

RUN curl -fS -o /tmp/wordpress.tar.gz "https://wordpress.org/wordpress-${WP_VERSION}.tar.gz" \
 && mkdir -p /var/www/html \
 && tar xzf /tmp/wordpress.tar.gz -C /var/www/html --strip-components=1 \
 && rm -f /var/www/html/index.html \
 && rm /tmp/wordpress.tar.gz

RUN mkdir -p /root/.ssh /run/sshd /etc/ssh/sshd_config.d \
 && chmod 700 /root/.ssh

ARG SSH_AUTHORIZED_KEYS=
RUN if [ -n "${SSH_AUTHORIZED_KEYS}" ]; then \
      printf '%s\n' "${SSH_AUTHORIZED_KEYS}" > /root/.ssh/authorized_keys && chmod 600 /root/.ssh/authorized_keys; \
    fi

RUN sed -i 's/#PermitRootLogin prohibit-password/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config \
 && sed -i 's/#PasswordAuthentication yes/PasswordAuthentication no/' /etc/ssh/sshd_config

COPY wp-entrypoint.sh /usr/local/bin/wp-entrypoint.sh
COPY wp-config-gen.sh /usr/local/bin/wp-config-gen.sh
RUN chmod +x /usr/local/bin/wp-entrypoint.sh /usr/local/bin/wp-config-gen.sh

ENTRYPOINT ["wp-entrypoint.sh"]
CMD []
