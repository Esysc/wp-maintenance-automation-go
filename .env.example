# WP Maintenance Automation Go - Deployment Configuration

# Server Ports
API_PORT=8081
WEB_PORT=8080

# Data Directory
DATA_DIR=./data

# Logging
LOG_LEVEL=info
DEBUG=false

# Domain Configuration (for Caddy reverse proxy with Let's Encrypt)
# WP_MAINTENANCE_DOMAIN=your-domain.com
# WP_MAINTENANCE_API_DOMAIN=api.your-domain.com

# TLS Configuration (HTTPS with self-signed cert is enabled by default)
# Set WEB_TLS_DISABLE=true for plain HTTP (not recommended for production)
# Or provide your own cert files:
# WEB_TLS_CERT_FILE=/path/to/cert.pem
# WEB_TLS_KEY_FILE=/path/to/key.pem
